[Unit]
Description=VPN Gateway Python Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vpngw-bot
Group=vpngw-bot
WorkingDirectory=/home/pi/app/vpngw
EnvironmentFile=/etc/vpngw-bot.env
ExecStart=/home/pi/.venv/bin/python -m vpngw_bot
Restart=on-failure
RestartSec=10
NoNewPrivileges=false
ReadWritePaths=/var/lib/vpngw /tmp

[Install]
WantedBy=multi-user.target
